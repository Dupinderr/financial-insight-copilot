# Copy to .env and fill in. Never commit the real .env — it is gitignored.
#
#   cp .env.example .env
#
# On Streamlit Community Cloud there is no .env file: paste these same
# key = "value" pairs into Settings -> Secrets instead (TOML format, so quote
# the values). Streamlit exposes top-level secrets as environment variables,
# which is what this project reads.

# --- required ----------------------------------------------------------------
# https://console.groq.com/keys  (free tier: 100k tokens/day)
GROQ_API_KEY=

# --- optional: tracing -------------------------------------------------------
# https://cloud.langfuse.com -> project -> Settings -> API Keys
# Leave blank to disable; the app runs identically untraced.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Must match your signup region, or auth silently fails:
#   EU -> https://cloud.langfuse.com
#   US -> https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# --- optional: split deployment ----------------------------------------------
# Unset (the default) runs the agents inside the Streamlit process, which is
# what Streamlit Community Cloud needs. Set it to a hosted FastAPI instance to
# have the UI call that instead, e.g. https://your-api.onrender.com
COPILOT_API_URL=
